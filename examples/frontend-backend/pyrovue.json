{
  "$schema": "https://raw.githubusercontent.com/yusufbadar/run-on-pyrovue/main/pyrovue.schema.json",
  "setup": [
    "cd /workspace/backend && pip install -r requirements.txt",
    "npm install"
  ],
  "services": [
    {
      "cwd": "backend",
      "start": "uvicorn main:app --port 8000",
      "port": 8000
    }
  ],
  "cwd": "frontend",
  "start": "npm run dev",
  "port": 5173
}
